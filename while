bandas = []
banda=""
while True:
    banda = input("Escribe tu banda favorita: ")

    if banda.lower() == "salir":
        break
    else:
        bandas.append(banda)
for banda_nombre in bandas:
    print(banda_nombre)
print(f"Escribiste {len(bandas)} bandas")
print(f"Tu primera banda fue {bandas[0]}")